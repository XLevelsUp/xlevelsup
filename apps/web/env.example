# ── apps/web — www.xlevelsup.com (marketing) ────────────────────────────────
# This app holds NO database credentials. Team data comes from the admin app
# over HTTP (see lib/team.ts), so SUPABASE_SERVICE_ROLE_KEY must never be set
# here.

# Origin of the admin app (ERP + employee portal). Used for the /team fetch
# and the footer's portal links.
# Local dev: http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=https://admin.xlevelsup.com

# ── Google Sheets API (lead capture) ───────────────────────────────────────
GOOGLE_SHEET_ID=
GOOGLE_CLIENT_EMAIL=
# Wrap in quotes; contains literal \n sequences for newlines.
# Example: "-----BEGIN PRIVATE KEY-----\nYourKeyHere\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=""

# Optional: admin email for lead notifications
ADMIN_EMAIL=

# ── Instagram Reels embed ──────────────────────────────────────────────────
# From the Meta developer app (XLU_Reels-IG) — Instagram API with Instagram Login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Long-lived Instagram user access token (valid ~60 days, refresh before expiry)
INSTAGRAM_ACCESS_TOKEN=
