# ── apps/admin — admin.xlevelsup.com (ERP + employee portal) ───────────────
# This app owns every database credential. Nothing here belongs in apps/web.

# Public origin of this app. Used for metadataBase.
# Local dev: http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=https://admin.xlevelsup.com

# ── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://vwgsbstkbjygokydvnia.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Service role bypasses RLS. Server-side only — never import lib/supabase-server
# from a client component.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ── Sessions ───────────────────────────────────────────────────────────────
# Signs the `erp-session` and `employee_session` JWTs. Change in production.
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
